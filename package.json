{
  "scripts": {
    "start": "webpack-dev-server --open",
    "testrpc": "yarn migrate_testrpc && ETH_ENV=testrpc yarn start",
    "ropsten": "yarn migrate_ropsten && ETH_ENV=ropsten yarn start",
    "kovan": "yarn migrate_kovan && ETH_ENV=kovan yarn start",
    "migrate_testrpc": "./bash_scripts/compile_contracts.sh testrpc",
    "migrate_ropsten": "./bash_scripts/compile_contracts.sh ropsten",
    "migrate_kovan": "./bash_scripts/compile_contracts.sh kovan",
    "clean": "rm -rf build",
    "prebuild": "yarn clean",
    "build": "NODE_ENV=production webpack",
    "build_ipfs_ropsten": "NODE_ENV=production ETH_ENV=ropsten webpack",
    "build_ipfs_kovan": "NODE_ENV=production ETH_ENV=kovan webpack",
    "deploy_ipfs_ropsten": "yarn migrate_ropsten && yarn build_ipfs_ropsten && ./bash_scripts/deploy_ipfs.sh ropsten",
    "deploy_ipfs_kovan": "yarn migrate_kovan && yarn build_ipfs_kovan && ./bash_scripts/deploy_ipfs.sh kovan",
    "lint": "eslint client --ignore-path .gitignore",
    "lint:fix": "npm run lint -- --fix",
    "lintstyle": "stylelint 'client/**/*.css'",
    "lintstyle:fix": "stylefmt -r client/**/*.css"
  },
  "git_lint": {
    "scripts": {
      "pre-commit": "npm run lint && npm run lintstyle"
    }
  },
  "dependencies": {
    "bignumber.js": "^4.0.0",
    "bootstrap": "^4.0.0-alpha.6",
    "ethereumjs-tx": "^1.2.5",
    "moment": "^2.18.1",
    "react": "^15.4.2",
    "react-addons-css-transition-group": "^15.4.2",
    "react-addons-transition-group": "^15.4.2",
    "react-dom": "^15.4.2",
    "react-fontawesome": "^1.5.0",
    "react-router": "^3.0.2",
    "reactstrap": "^4.2.0",
    "truffle-contract": "^2.0.0",
    "victory": "^0.18.2",
    "web3": "^0.18.2"
  },
  "devDependencies": {
    "babel": "^6.23.0",
    "babel-cli": "^6.23.0",
    "babel-core": "^6.23.1",
    "babel-eslint": "^7.1.1",
    "babel-loader": "^6.3.2",
    "babel-plugin-transform-async-to-generator": "^6.22.0",
    "babel-plugin-transform-runtime": "^6.23.0",
    "babel-preset-es2015": "^6.22.0",
    "babel-preset-latest": "^6.22.0",
    "babel-preset-react": "^6.23.0",
    "babel-preset-stage-0": "^6.22.0",
    "css-loader": "^0.26.2",
    "eslint": "^3.17.0",
    "eslint-config-standard": "^7.0.0",
    "eslint-config-standard-react": "^4.2.0",
    "eslint-plugin-import": "^2.2.0",
    "eslint-plugin-promise": "^3.5.0",
    "eslint-plugin-react": "^6.10.0",
    "eslint-plugin-standard": "^2.1.1",
    "file-loader": "^0.10.1",
    "git-scripts": "^0.2.1",
    "html-webpack-plugin": "^2.28.0",
    "postcss": "^5.2.15",
    "postcss-loader": "^1.3.3",
    "postcss-sorting": "^2.0.1",
    "react": "^15.4.2",
    "react-dom": "^15.4.2",
    "react-hot-loader": "^3.0.0-beta.6",
    "style-loader": "^0.13.2",
    "stylefmt": "^5.1.2",
    "stylelint": "^7.9.0",
    "stylelint-config-standard": "^16.0.0",
    "stylelint-order": "^0.3.0",
    "webpack": "^2.2.1",
    "webpack-dev-server": "^2.4.1",
    "webpack-error-notification": "^0.1.6"
  }
}
